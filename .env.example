# Copy to .env.local for local dev (gitignored).
# On Netlify / production, set the SAME variable names in the host UI —
# do NOT rely on committing a production .env.

# --- Local Docker (raven.local) ---
# VITE_FRAPPE_API_URL=http://raven.local:8000
# VITE_TENANT_BASE_DOMAIN=nithrateams.com

# --- Production central site (example) ---
# VITE_FRAPPE_API_URL=https://saas.nithrateams.com
# VITE_TENANT_BASE_DOMAIN=nithrateams.com

VITE_FRAPPE_API_URL=http://raven.local:8000
VITE_TENANT_BASE_DOMAIN=nithrateams.com
